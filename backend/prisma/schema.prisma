// schema.prisma — Model data mengikuti SRS §6.
// Konvensi: id UUID, waktu UTC, uang pakai Decimal (bukan float),
// role CUSTOMER/ADMIN, kode & pesan pengguna dalam bahasa Indonesia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum HandoverType {
  DROP_OFF
  PICKUP
}

enum ServiceType {
  REGULAR
  EXPRESS
}

enum ServiceUnit {
  KG
  ITEM
}

enum OrderStatus {
  RECEIVED
  WASHING
  DRYING_IRONING
  PACKED
  READY
  COMPLETED
  CANCELLED
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  phone                String    @unique // format 62… (BR-07)
  passwordHash         String
  role                 Role      @default(CUSTOMER)
  isActive             Boolean   @default(true)
  defaultPickupAddress String?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  bookings            Booking[]
  orders              Order[]
  orderStatusLogs     OrderStatusLog[]

  @@index([email])
  @@index([phone])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Service {
  id             String      @id @default(uuid())
  name           String
  description    String?
  type           ServiceType
  price          Decimal     @db.Decimal(12, 2)
  unit           ServiceUnit @default(KG)
  estimatedHours Int
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  bookings   Booking[]
  orderItems OrderItem[]
}

model Promotion {
  id          String    @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean   @default(true)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id                String        @id @default(uuid())
  code              String        @unique
  userId            String
  serviceId         String
  estimatedQuantity Decimal?      @db.Decimal(10, 2)
  handoverType      HandoverType  @default(DROP_OFF)
  pickupAddress     String?
  notes             String?
  status            BookingStatus @default(PENDING)
  rejectionReason   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order   Order?

  @@index([userId, status])
  @@index([status, createdAt])
}

model Order {
  id              String      @id @default(uuid())
  code            String      @unique
  bookingId       String?     @unique
  userId          String?
  customerName    String
  customerPhone   String
  status          OrderStatus @default(RECEIVED)
  totalPrice      Decimal?    @db.Decimal(12, 2)
  entryAt         DateTime    @default(now())
  estimatedDoneAt DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  booking    Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  statusLogs OrderStatusLog[]

  @@index([userId])
  @@index([status, readyAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  serviceId String
  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderStatusLog {
  id              String      @id @default(uuid())
  orderId         String
  status          OrderStatus
  changedByUserId String?
  note            String?
  changedAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
