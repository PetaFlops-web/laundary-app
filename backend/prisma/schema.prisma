// schema.prisma — Model data mengikuti SRS §6.
// Konvensi: id UUID, waktu UTC, uang pakai Decimal (bukan float),
// role CUSTOMER/ADMIN, kode & pesan pengguna dalam bahasa Indonesia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum HandoverType {
  DROP_OFF
  PICKUP
}

enum FulfillmentType {
  DELIVERY
  SELF_PICKUP
}

enum ServiceType {
  REGULAR
  EXPRESS
}

enum ServiceUnit {
  KG
  ITEM
}

enum OrderStatus {
  PICKED_UP
  WEIGHED
  AWAITING_PAYMENT
  PAID
  COMPLETED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum Actor {
  USER
  ADMIN
  SYSTEM
}

enum MessageSenderRole {
  CUSTOMER
  ADMIN
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String    @unique // format 62… (BR-07)
  passwordHash    String
  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  defaultAddress  String
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  bookings            Booking[]
  orders              Order[]
  orderStatusLogs     OrderStatusLog[]
  conversation        Conversation?
  messages            Message[]

  @@index([email])
  @@index([phone])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Service {
  id             String      @id @default(uuid())
  name           String
  description    String?
  type           ServiceType
  price          Decimal     @db.Decimal(12, 2)
  unit           ServiceUnit @default(KG)
  estimatedHours Int
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  bookings Booking[]
  orders   Order[]

  @@index([isActive])
}

model Booking {
  id                String          @id @default(uuid())
  code              String          @unique
  userId            String
  serviceId         String
  estimatedQuantity Decimal?        @db.Decimal(10, 2)
  handoverType      HandoverType    @default(DROP_OFF)
  fulfillmentType   FulfillmentType @default(SELF_PICKUP)
  pickupAddress     String?
  deliveryAddress   String?
  notes             String?
  status            BookingStatus   @default(PENDING)
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order   Order?

  @@index([userId, status])
  @@index([status, createdAt])
}

model Order {
  id              String      @id @default(uuid())
  code            String      @unique
  bookingId       String?     @unique
  userId          String?
  serviceId       String
  customerName    String
  customerPhone   String
  deliveryAddress String?
  status          OrderStatus @default(PICKED_UP)
  weightKg        Decimal?    @db.Decimal(10, 3)
  suggestedPrice  Decimal?    @db.Decimal(12, 2)
  totalPrice      Decimal?    @db.Decimal(12, 2)
  priceNote       String?
  pickedUpAt      DateTime    @default(now())
  weighedAt       DateTime?
  pricedAt        DateTime?
  paidAt          DateTime?
  completedAt     DateTime?
  deliveredAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  booking    Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  service    Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments   Payment[]
  delivery    Delivery?
  statusLogs  OrderStatusLog[]
  messages    Message[]

  @@index([userId])
  @@index([status, pricedAt])
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  provider              String
  providerOrderId       String        @unique
  providerTransactionId String?
  grossAmount           Decimal       @db.Decimal(12, 2)
  method                String?
  status                PaymentStatus @default(PENDING)
  paymentToken          String?
  paymentUrl            String?
  expiresAt             DateTime?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  webhookEvents PaymentWebhookEvent[]

  @@index([orderId, status])
  @@index([providerOrderId])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  paymentId       String?
  providerEventId String    @unique
  status          String
  signatureValid  Boolean
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

model Delivery {
  id           String    @id @default(uuid())
  orderId      String    @unique
  address      String
  courierName  String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusLog {
  id              String      @id @default(uuid())
  orderId         String
  status          OrderStatus
  actor           Actor       @default(ADMIN)
  changedByUserId String?
  note            String?
  changedAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Conversation {
  id            String   @id @default(uuid())
  userId        String   @unique
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     MessageSenderRole
  orderId        String?
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
