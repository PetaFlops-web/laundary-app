# ===== Docker Compose (postgres) =====
DB_USER=laundary_user
DB_PASSWORD=CHANGE_ME
DB_NAME=laundary_db
DB_PORT=5433

# ===== Aplikasi =====
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://laundary_user:CHANGE_ME@localhost:5433/laundary_db"

# JWT
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173

# Seed admin awal (BR-09) — kredensial dari owner
ADMIN_EMAIL=owner@achilla.id
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Owner
ADMIN_PHONE=6280000000000

# Bisnis
REMINDER_DEFAULT_DAYS=3